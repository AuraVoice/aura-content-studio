# Public app URL, without a trailing slash
APP_URL=http://localhost:3000

# One-person dashboard login
STUDIO_USERNAME=owner
STUDIO_PASSWORD=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=

# Google Gemini API
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_VIDEO_MODEL=gemini-3.5-flash

# Brave Search API. Use SEARCH_PROVIDER=mock for local development.
SEARCH_PROVIDER=mock
BRAVE_SEARCH_API_KEY=

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Use the Supabase Session Pooler connection string for Vercel.
DATABASE_URL=
SUPABASE_STORAGE_BUCKET=aura-content-media

# Vercel sends this value as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Optional: changes the local mock clock and daily campaign date
STUDIO_TIMEZONE=America/Los_Angeles
